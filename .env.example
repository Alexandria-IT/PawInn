# Copy to .env for your LOCAL college demo. Never commit real credentials.
# All three Express services connect to the SAME application database.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=pawinn
POSTGRES_PASSWORD=replace-with-a-local-demo-password
POSTGRES_DB=pawinn

# Backend owners read the same POSTGRES_* settings, including POSTGRES_DB.
# Compose API containers use POSTGRES_HOST=postgres and POSTGRES_PORT=5432.
# Use a unique local JWT_SECRET of at least 32 bytes (see the root README.md).
ACCOUNT_PORT=3001
ROOM_PORT=3002
BOOKING_PORT=3003
JWT_SECRET=replace-with-a-local-demo-signing-secret

FRONTEND_PORT=8080

# Set true only for an isolated course verification database.
PAWINN_SEED_DEMO=true
